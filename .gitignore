# saQut Compiler
saqut
*.o
*.exe
*.out
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Parola içerebilen yerel API istemcisi - asla commit edilmez
scripts/gitea.py

# Python bytecode cache
__pycache__/

# CMake versiyona özgü dosyalar (otomatik üretilir, her güncellemede değişir)
build/*

# Benchmark — üretilmiş dosyalar (gen_compile_suite.py tarafından üretilir)
scripts/bench/compile_suite/

# Java benchmark sınıfları (javac tarafından üretilir)
scripts/bench/*.class

# AI asistan önbellek ve çalışma dizinleri
.deepseek/
.zcode/
.codewhale/

# AI görev artifact'ları global/ignore edilen dosyalarda tutulmaz.
# Yeni görevler tasks/<TASK-ID>/ altında görünür ve denetlenebilir olmalıdır.

# Website
webside/
webside/*
saqutwebside/

# Belge ekran görüntüleri (üretilmiş, README/wiki'ye elle seçilerek eklenir)
screenshots/

# Vendored MIR (src/mir/vendor) — kaynak commit'lenir, kendi build çıktıları etmez
src/mir/vendor/*.a
src/mir/vendor/*.so*
src/mir/vendor/*.d
src/mir/vendor/c2m
src/mir/vendor/m2b
src/mir/vendor/b2m
src/mir/vendor/b2ctab
src/mir/vendor/mir-bin-run
src/mir/vendor/c2mir/*.o
src/mir/vendor/c2mir/*.d
src/mir/vendor/mir-utils/*.o
src/mir/vendor/mir-utils/*.d

# Build klasörleri — yalnız aktif `build/` kullanılır (Release, build-release.sh);
# diğer build profilleri (asan/o3/miro2/rel) üretilmiş çıktıdır, izlenmez.
build-asan/
build-o3/
build-miro2/
build-rel/
.codewhale
.ruff_cache

systemcalls
systemcalls/*
systemcalls/**
# geçici çalışma alanı (GC turu) — izlenmez
temp/
