{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "saQut",
  "scopeName": "source.sqt",
  "fileTypes": [
    "sqt"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#types_user"
    },
    {
      "include": "#collection_new"
    },
    {
      "include": "#keywords_thread"
    },
    {
      "include": "#keywords_control"
    },
    {
      "include": "#keywords_type"
    },
    {
      "include": "#keywords_module"
    },
    {
      "include": "#keywords_other"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sqt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sqt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sqt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sqt",
          "match": "\\\\[ntrb\\\\\"]"
        },
        {
          "name": "invalid.illegal.escape.sqt",
          "match": "\\\\."
        }
      ]
    },
    "keywords_control": {
      "name": "keyword.control.sqt",
      "match": "\\b(if|else|for|while|do|return|break|continue|switch|case|default|try|catch|throw)\\b"
    },
    "keywords_type": {
      "patterns": [
        {
          "name": "storage.type.sqt",
          "match": "\\b(int|longint|float|double|decimal|byte|date|char|string|bool|void|auto|Pool|List|Thread)[ \\t]*\\?"
        },
        {
          "name": "storage.type.sqt",
          "match": "\\b(int|longint|float|double|decimal|byte|date|char|string|bool|void|auto|Pool|List|Thread)[ \\t]*\\[\\]"
        },
        {
          "name": "storage.type.sqt",
          "match": "\\b(int|longint|float|double|decimal|byte|date|char|string|bool|void|auto|Pool|List|Thread)\\b"
        }
      ]
    },
    "keywords_thread": {
      "comment": "ADR-045: shared bir depolama niteleyicisi; thread/lock/unlock/wait kontrol akışı. keywords_control ve functions'tan önce gelir (wait( fonksiyon çağrısı sanılmasın).",
      "patterns": [
        {
          "name": "storage.modifier.shared.sqt",
          "match": "\\bshared\\b"
        },
        {
          "name": "keyword.control.thread.sqt",
          "match": "\\b(thread|lock|unlock|wait)\\b"
        }
      ]
    },
    "collection_new": {
      "comment": "ADR-045: Pool(T) / List(T) — parantez içindeki argüman bir TİP adıdır (int, string[], Job?).",
      "match": "\\b(Pool|List)\\s*(\\()\\s*([A-Za-z_$][A-Za-z0-9_$]*)((?:\\s*\\[\\])*)(\\s*\\?)?\\s*(\\))",
      "captures": {
        "1": {
          "name": "storage.type.sqt"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.sqt"
        },
        "3": {
          "patterns": [
            {
              "name": "storage.type.sqt",
              "match": "\\b(int|longint|float|double|decimal|byte|date|char|string|bool|void|auto|Pool|List|Thread)\\b"
            },
            {
              "name": "entity.name.type.sqt",
              "match": ".+"
            }
          ]
        },
        "4": {
          "name": "storage.type.sqt"
        },
        "5": {
          "name": "storage.type.sqt"
        },
        "6": {
          "name": "punctuation.definition.parameters.end.sqt"
        }
      }
    },
    "keywords_module": {
      "name": "keyword.other.sqt",
      "match": "\\b(import|export|from|struct|enum|as)\\b"
    },
    "keywords_other": {
      "name": "keyword.other.sqt",
      "match": "\\b(ffi)\\b"
    },
    "constants": {
      "name": "constant.language.sqt",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sqt",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.sqt",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.sqt",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.sqt",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.sqt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.sqt",
      "match": "(\\*\\*|<<=|>>=|<<|>>|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!&|^~])"
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_$][A-Za-z0-9_$]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.sqt"
            }
          }
        }
      ]
    },
    "types_user": {
      "match": "\\b(struct|enum)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "keyword.other.sqt"
        },
        "2": {
          "name": "entity.name.type.sqt"
        }
      }
    }
  }
}