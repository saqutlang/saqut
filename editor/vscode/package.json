{
  "name": "saqut",
  "displayName": "saQut Language",
  "description": "saQut dil desteği: sözdizimi renklendirme, LSP ve DAP entegrasyonu",
  "version": "1.0.1",
  "publisher": "saqut",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:sqt"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sqt",
        "aliases": [
          "saQut",
          "sqt"
        ],
        "extensions": [
          ".sqt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sqt",
        "scopeName": "source.sqt",
        "path": "./syntaxes/sqt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "saqut.restartLanguageServer",
        "title": "saQut: Language Server'ı Yeniden Başlat",
        "category": "saQut"
      }
    ],
    "configuration": {
      "title": "saQut",
      "properties": {
        "saqut.path": {
          "type": "string",
          "default": "saqut",
          "description": "saqut derleyici binary'sinin yolu. PATH'te değilse mutlak yol verin. Değişiklikten sonra 'saQut: Language Server'ı Yeniden Başlat' komutunu çalıştırın."
        },
        "saqut.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "verbose"
          ],
          "default": "off",
          "description": "LSP iletişimini 'saQut LSP Trace' kanalına yaz (verbose). Sorun ayıklarken açın."
        }
      }
    },
    "breakpoints": [
      {
        "language": "sqt"
      }
    ],
    "debuggers": [
      {
        "type": "sqt",
        "label": "saQut Debug",
        "languages": [
          "sqt"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Çalıştırılacak .sqt dosyası",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Programın ilk satırında dur",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sqt",
            "request": "launch",
            "name": "saQut Debug",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "saQut: Dosyayı Debug Et",
            "description": "Açık .sqt dosyasını saQut debugger ile başlat",
            "body": {
              "type": "sqt",
              "request": "launch",
              "name": "saQut Debug",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "builtin": [
            "keyword.operator"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "sqt",
        "path": "./snippets/sqt.json"
      }
    ],
    "configurationDefaults": {
      "[sqt]": {
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.tabCompletion": "onlySnippets",
        "editor.snippetSuggestions": "top"
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "esbuild extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node18",
    "watch": "esbuild extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node18 --watch",
    "package": "npm run compile && vsce package --no-dependencies",
    "test:grammar": "node test/grammar.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
