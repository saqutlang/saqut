{
  "if": {
    "prefix": "if",
    "body": [
      "if ($1) {",
      "\t$0",
      "}"
    ],
    "description": "if statement"
  },
  "if/else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "elif",
    "body": [
      "else if ($1) {",
      "\t$0",
      "}"
    ],
    "description": "else if"
  },
  "else": {
    "prefix": "else",
    "body": [
      "else {",
      "\t$0",
      "}"
    ],
    "description": "else"
  },
  "do-while": {
    "prefix": "do",
    "body": [
      "do {",
      "\t$2",
      "} while ($1);$0"
    ],
    "description": "do { } while (condition);"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ($1) {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "while(true)": {
    "prefix": "wt",
    "body": [
      "while (true) {",
      "\t$1",
      "\tif (${2:done}) {",
      "\t\tbreak;",
      "\t}",
      "}$0"
    ],
    "description": "while (true) with break"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:n}; $1++) {",
      "\t$0",
      "}"
    ],
    "description": "counting for loop"
  },
  "for array": {
    "prefix": "fora",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:array}.length(); $1++) {",
      "\t${3:int} ${4:item} = $2[$1];",
      "\t$0",
      "}"
    ],
    "description": "loop over an array"
  },
  "for reverse": {
    "prefix": "forr",
    "body": [
      "for (int ${1:i} = ${2:n} - 1; $1 >= 0; $1--) {",
      "\t$0",
      "}"
    ],
    "description": "reverse for loop"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:1}:",
      "\t\t$3",
      "\tdefault:",
      "\t\t$0",
      "}"
    ],
    "description": "switch (no fall-through)"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "${1:int} ${2:name}(${3}) {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "void function": {
    "prefix": "fnv",
    "body": [
      "void ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "void function"
  },
  "main": {
    "prefix": "main",
    "body": [
      "int main() {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "entry point"
  },
  "struct": {
    "prefix": "st",
    "body": [
      "struct ${1:Name} {",
      "\t${2:int} ${3:field};$0",
      "}"
    ],
    "description": "struct"
  },
  "export struct": {
    "prefix": "est",
    "body": [
      "export struct ${1:Name} {",
      "\t${2:int} ${3:field};$0",
      "}"
    ],
    "description": "exported struct"
  },
  "enum": {
    "prefix": "en",
    "body": [
      "enum ${1:Name} { ${2:A}, ${3:B} }$0"
    ],
    "description": "enum"
  },
  "try/catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (Error ${2:e}) {",
      "\t${0:print($2.message);}",
      "}"
    ],
    "description": "try / catch"
  },
  "throw": {
    "prefix": "throw",
    "body": [
      "throw \"${1:message}\";$0"
    ],
    "description": "throw an error"
  },
  "import stdlib": {
    "prefix": "imp",
    "body": [
      "import { $2 } from ${1|fs,path,utf8,sys,process,stdin,stdout,stderr,math,date,os,terminal|};$0"
    ],
    "description": "import from a standard library module"
  },
  "import file": {
    "prefix": "impf",
    "body": [
      "import { $2 } from \"${1:module}.sqt\";$0"
    ],
    "description": "import from a source file"
  },
  "null check": {
    "prefix": "nn",
    "body": [
      "if (${1:value} != null) {",
      "\t$0",
      "}"
    ],
    "description": "narrow a nullable value"
  },
  "print line": {
    "prefix": "pl",
    "body": [
      "print(${1:value});",
      "print(\"\\n\");$0"
    ],
    "description": "print value and newline"
  },
  "read lines": {
    "prefix": "readl",
    "body": [
      "while (true) {",
      "\tstring? ${1:line} = readLine();",
      "\tif ($1 == null) {",
      "\t\tbreak;",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "read stdin line by line (needs: import { readLine } from stdin;)"
  },
  "read file": {
    "prefix": "rf",
    "body": [
      "string ${1:text} = decode(readFile(\"${2:path}\"));$0"
    ],
    "description": "read a text file (needs readFile from fs, decode from utf8)"
  },
  "program args": {
    "prefix": "args",
    "body": [
      "string[] ${1:a} = args();",
      "for (int ${2:i} = 0; $2 < $1.length(); $2++) {",
      "\t$0",
      "}"
    ],
    "description": "loop over program arguments (needs: import { args } from sys;)"
  }
}