// ADR-045 örneği: üretici-tüketici. İki üretici sınırlı bir Pool'a 1..2000
// sayılarını koyar; üç tüketici alıp paylaşımlı toplama ekler. -1 bir tüketiciyi
// durdurur. Çıktı deterministiktir: toplam ve işlenen eleman sayısı.
shared Pool jobs = Pool(int);
shared int total = 0;
shared int consumed = 0;

void consume() {
    while (true) {
        int j = jobs.pop();
        if (j < 0) {
            return;
        }
        total += j;
        consumed += 1;
    }
}

int main() {
    jobs.setMax(16);
    Thread p1 = thread {
        for (int i = 1; i <= 1000; i = i + 1) {
            jobs.push(i);
        }
    };
    Thread p2 = thread {
        for (int i = 1001; i <= 2000; i = i + 1) {
            jobs.push(i);
        }
    };
    Thread c1 = thread { consume(); };
    Thread c2 = thread { consume(); };
    Thread c3 = thread { consume(); };

    p1.join();
    p2.join();
    jobs.push(-1);
    jobs.push(-1);
    jobs.push(-1);
    c1.join();
    c2.join();
    c3.join();

    print(total);
    print("\n");
    print(consumed);
    print("\n");
    return 0;
}
