// ADR-045 örneği: iç içe thread, iç içe yakalama ve wait. İçteki thread,
// main'in yereli k'yı dıştaki thread üzerinden kopya olarak alır.
shared int stage = 0;

int main() {
    int k = 7;
    Thread outer = thread {
        Thread inner = thread {
            stage = k - 6;
        };
        inner.join();
        wait(stage == 1);
        stage = 2;
    };
    wait(stage == 2);
    outer.join();
    print(stage);
    print("\n");
    return 0;
}
