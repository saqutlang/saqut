// ============================================================================
// saQut çekirdek — FFI bildirimleri
// ============================================================================
//
// Gömülü host fonksiyonlarının `ffi` bildirimleri. Derleyici binary'sine
// gömülür (src/internal/, scripts/embed_internal.py) ve süreç ömründe bir kez
// parse edilir (FfiCatalog).
//
// Önceden src/ffi/root_sqt.hpp içinde C++ ham string'i olarak duruyordu;
// artık gerçek bir .sqt dosyasıdır: editörde açılır, syntax highlight çalışır,
// LSP görür.
//
// İleride modüllere ayrılacak (date/math/fs/sys ayrı dosyalar) — şimdilik tek
// dosya, eski davranışla birebir.
//
// Yeni host fonksiyonu = C++ gövde (host_functions.cpp veya src/data/) +
// buraya 1 ffi satırı + 1 tablo girdisi. Sembolik HOST_ID tablodaki adla
// eşleşmeli.
// ============================================================================

// ── core modülü (import gerektirmez, her zaman mevcut) ─────────────────────
ffi string version() : CORE_VERSION from core;   // derleyici sürümü (0.9.4)

// ── math modülü (saf hesap — #89) ───────────────────────────────────────────
// Overload yok → int/ondalık ayrımı isimle (abs/absf). ADR-040: ondalık
// matematik 64-bit `double` üzerinden (isimlerdeki "f" tarihsel; tip double).
// sqrt(-1)=NaN, Error fırlatmaz.
ffi int    abs(int x)               : MATH_ABS   from math;
ffi double absf(double x)           : MATH_ABSF  from math;
ffi int    min(int a, int b)        : MATH_MIN   from math;
ffi int    max(int a, int b)        : MATH_MAX   from math;
ffi double minf(double a, double b) : MATH_MINF  from math;
ffi double maxf(double a, double b) : MATH_MAXF  from math;
ffi double sqrt(double x)           : MATH_SQRT  from math;
ffi double pow(double b, double e)  : MATH_POW   from math;
ffi double floor(double x)          : MATH_FLOOR from math;
ffi double ceil(double x)           : MATH_CEIL  from math;
ffi double round(double x)          : MATH_ROUND from math;
// #89: gerçek importable sabit yok (ffi yalnızca fonksiyon) — sıfır-argümanlı
// saf fonksiyon olarak sunulur: import {PI} from math; PI();
ffi double PI()                     : MATH_PI    from math;
ffi double E()                      : MATH_E     from math;

// ── fs modülü (dosya sistemi — #87) ─────────────────────────────────────────
// Handle/descriptor YOK — tek atımlık read/write (record-replay önkoşulu).
// İsim kuralı (ürün kararı 2026-08-25): fiil+özne, `...File` soneki; dizin/
// meta sorguları öznesiz (isEmpty/isDirectory — dosya-işlemi değil). Çarpışma
// isteyen `import {readFile as fileRead} from fs` ile kendi takma adını verir.
ffi byte[]  readFile(string path, int? seek, int? size)  : FS_READ_FILE   from fs;
ffi void    writeFile(string path, byte[] data)   : FS_WRITE_FILE  from fs;
ffi void    appendFile(string path, byte[] data)  : FS_APPEND      from fs;
ffi bool    existsFile(string path)               : FS_EXISTS      from fs;
ffi void    removeFile(string path)               : FS_REMOVE      from fs;
ffi void    createFile(string path)               : FS_CREATE_FILE from fs;
ffi void    copyFile(string src, string dst)      : FS_COPY_FILE   from fs;
ffi void    renameFile(string from, string to)    : FS_RENAME_FILE from fs;
ffi bool    isEmpty(string path)                  : FS_IS_EMPTY    from fs;
ffi bool    isDirectory(string path)              : FS_IS_DIRECTORY from fs;
ffi longint fileSize(string path)                 : FS_FILE_SIZE   from fs;

// ── sys modülü (#90) ────────────────────────────────────────────────────────
// Non-deterministik/dış-durum-okuyan; OS CSPRNG (rand() DEĞİL).
ffi double   random()                          : SYS_RANDOM     from sys;   // gövde double (#227 tip uyumu)
ffi int      randomInt(int lo, int hi)         : SYS_RANDOM_INT from sys;
ffi string?  env(string name)                  : SYS_ENV        from sys;
ffi void     sleep(int millis)                 : SYS_SLEEP      from sys;
ffi string[] args()                            : SYS_ARGS       from sys;

// ── date modülü (UTC epoch-ms değer tipi — #88, ADR-036) ────────────────────
// Yalnızca now() dış-durum-okuyan; geri kalan saf hesap (determinizmi bozmaz).
ffi date    now()                               : DATE_NOW           from date;
ffi date    fromEpochMillis(longint milliseconds) : DATE_FROM_EPOCH_MS from date;
ffi longint toEpochMillis(date value)             : DATE_TO_EPOCH_MS   from date;
ffi date    addDays(date d, int n)              : DATE_ADD_DAYS      from date;
ffi date    addHours(date d, int n)             : DATE_ADD_HOURS     from date;
ffi date    addMinutes(date d, int n)           : DATE_ADD_MINUTES   from date;
ffi date    addSeconds(date d, int n)           : DATE_ADD_SECONDS   from date;
ffi int     year(date d)                        : DATE_YEAR          from date;
ffi int     month(date d)                       : DATE_MONTH         from date;
ffi int     day(date d)                         : DATE_DAY           from date;
ffi int     hour(date d)                        : DATE_HOUR          from date;
ffi int     minute(date d)                      : DATE_MINUTE        from date;
ffi int     second(date d)                      : DATE_SECOND        from date;
ffi longint diffMillis(date left, date right)   : DATE_DIFF_MS       from date;
ffi date?   parse(string iso8601)               : DATE_PARSE         from date;
ffi string  format(date d, string pattern)      : DATE_FORMAT        from date;

// ── process modülü (süreç kontrolü — #115 Faz 1) ────────────────────────────
ffi void   exit(int code)             : PROCESS_EXIT   from process;
ffi string cwd()                      : PROCESS_CWD    from process;
ffi int    pid()                      : PROCESS_PID    from process;
ffi void   chdir(string path)         : PROCESS_CHDIR  from process;

// ── stdin / stdout / stderr modülleri (#115 Faz 1) ──────────────────────────
// Girdi: handle'sız tek atımlık (record-replay önkoşulu). Çıktı: capability'siz,
// print ile aynı stream; stdout outputSink DAP yönlendirmesine uyar.
ffi string? readLine()               : STDIN_READ_LINE  from stdin;
ffi string  readAll()                : STDIN_READ_ALL   from stdin;
ffi byte[]  readBytes()              : STDIN_READ_BYTES from stdin;
ffi void    write(string text)       : STDOUT_WRITE       from stdout;
ffi void    writeBytes(byte[] data)  : STDOUT_WRITE_BYTES from stdout;
ffi void    write(string text)       : STDERR_WRITE       from stderr;
ffi void    writeBytes(byte[] data)  : STDERR_WRITE_BYTES from stderr;

// ── path modülü (saf yol işlemleri — #115 Faz 1) ────────────────────────────
// capability'siz, deterministik. Değişken parametre YOK — join birden çok parça
// için string[] alır (ürün kararı 2026-08-26). absolute/relative YOK (cwd'ye
// bağımlı — dış durum; ihtiyaç olursa process::cwd() + join ile string düzeyinde).
ffi string join(string[] parts)   : PATH_JOIN        from path;
ffi string normalize(string path) : PATH_NORMALIZE   from path;
ffi string dirname(string path)   : PATH_DIRNAME     from path;
ffi string basename(string path)  : PATH_BASENAME    from path;
ffi string extension(string path) : PATH_EXTENSION   from path;
ffi bool   isAbsolute(string path): PATH_IS_ABSOLUTE from path;
ffi string separator()            : PATH_SEPARATOR   from path;

// ── utf8 modülü (saf dönüşüm — #115 Faz 1) ──────────────────────────────────
ffi byte[] encode(string text) : UTF8_ENCODE from utf8;
ffi string decode(byte[] data) : UTF8_DECODE from utf8;

// ── fs modülü — dizin yönetimi tamamlaması (#115 Faz 1) ─────────────────────
// move = renameFile (std::filesystem::rename zaten taşıma). list tek dizin adları
// (sıralı, yalnız isimler); walk recursive tam yol; modifiedTime epoch-ms longint.
ffi void      createDirectory(string path)  : FS_CREATE_DIRECTORY from fs;
ffi void      removeDirectory(string path)  : FS_REMOVE_DIRECTORY from fs;
ffi bool      isFile(string path)           : FS_IS_FILE          from fs;
ffi string[]  list(string path)             : FS_LIST             from fs;
ffi string[]  walk(string path)             : FS_WALK             from fs;
ffi longint   modifiedTime(string path)     : FS_MODIFIED_TIME    from fs;

// ── os + terminal modülleri (#115 Faz 2, izlenmiş) ──────────────────────────
// Salt tanılama (name/arch/hostname/user/cpuCount); terminal::isTTY renk çıktısı
// kararı için stdout'un gerçek terminale bağlı olup olmadığını sorar.
ffi string osName()     : OS_NAME      from os;
ffi string osArch()     : OS_ARCH      from os;
ffi string osHostname() : OS_HOSTNAME  from os;
ffi string? osUser()    : OS_USER      from os;
ffi int    osCpuCount() : OS_CPU_COUNT from os;
ffi bool   isTTY()      : TERMINAL_IS_TTY from terminal;

// ── net modülü (TCP, non-blocking + epoll) ──────────────────────────────────
// Soket/dinleyici int handle'dır (C++ nesnesi host tablosunda, dilde numara).
// Tek bloklayan çağrı pollSockets: çağıran thread'in epoll'unda bekler, yeni
// veri/bağlantı/EOF olan handle'ları döndürür. Yazma tamponludur (kısmi yazma
// görünmez). Okuma: null = şimdilik veri yok, "" = bağlantı kapandı (EOF),
// dolu = veri. Bildirilen bir bağlantı null dönene dek okunmalıdır.
// Motor: src/net/net_runtime.hpp.
ffi int     listenTcp(string host, int port, bool reusePort)       : NET_LISTEN_TCP  from net;
ffi int?    acceptSocket(int listener)                              : NET_ACCEPT      from net;
ffi int[]   pollSockets(int timeoutMs)                              : NET_POLL        from net;
ffi string? readSocket(int conn, int maxBytes)                      : NET_READ        from net;
ffi byte[]? readSocketBytes(int conn, int maxBytes)                 : NET_READ_BYTES  from net;
ffi string? readSocketUntil(int conn, string delimiter, int maxBytes) : NET_READ_UNTIL from net;
ffi string? readSocketExact(int conn, int size)                     : NET_READ_EXACT  from net;
ffi void    writeSocket(int conn, string data)                      : NET_WRITE       from net;
ffi void    writeSocketBytes(int conn, byte[] data)                 : NET_WRITE_BYTES from net;
ffi void    closeSocket(int handle)                                 : NET_CLOSE       from net;
ffi int     socketPort(int handle)                                  : NET_PORT        from net;
ffi string  socketPeer(int conn)                                    : NET_PEER        from net;
ffi int     socketPending(int conn)                                 : NET_PENDING     from net;

// ── tls modülü (TLS 1.3 sunucu, vendor OpenSSL statik) ──────────────────────
// serverContext bir bağlam handle'ı döndürür; listenTls ile açılan dinleyicinin
// kabul ettiği bağlantılar TLS'tir ve net'in read/write fonksiyonlarıyla aynı
// şekilde kullanılır (el sıkışma görünmez).
ffi int serverContext(string certPath, string keyPath)                 : TLS_SERVER_CONTEXT from tls;
ffi int listenTls(string host, int port, bool reusePort, int context)  : TLS_LISTEN         from tls;
