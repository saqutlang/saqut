// #237: ** üs alma. Eskiden parse ediliyor ama düşürülmüyordu — ikili
// operatör switch'inin `default:` dalı sessizce sabit 0 üretiyordu.
int main() {
    print(2 ** 3);        print("|");   // 8
    print(2 ** 0);        print("|");   // 1
    print(2 ** 3 ** 2);   print("|");   // 512 — SAĞ birleşmeli, (2**3)**2=64 değil
    print(3 ** 5);        print("|");   // 243

    int a = 5;  int b = 2;
    print(a ** b);        print("|");   // 25 — değişkenli (sabit katlanamaz)

    longint L = 3;
    print(L ** 5);        print("|");   // 243

    double d = 2.0;
    print(d ** 0.5);      print("|");   // 1.4142135623730951
    print(d ** -1.0);     print("|");   // 0.5 — ondalıkta negatif üs GEÇERLİ

    // Öncelik: ** tekli eksiden gevşek, çarpmadan sıkı
    print(2 * 3 ** 2);                  // 18 = 2 * 9
    return 0;
}
