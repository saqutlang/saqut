// read_range — readFile ofset/size (seek) API (#115 ürün kararı 2026-08-26)
// readFile(path), readFile(path, seek), readFile(path, seek, size) üç form;
// nullable trailing parametreler isteğe bağlı. İçerik "ABCDEFGHI" (9 bayt).
import {writeFile, readFile, existsFile, removeFile} from fs;
import {decode} from utf8;
import {pid} from process;
int main() {
    // PID son eki: ctest -j altında golden + differential eşzamanlı koşar.
    string path = "/tmp/saqut_read_range_" + (pid() as string) + ".txt";
    if (existsFile(path)) { removeFile(path); }
    writeFile(path, [65,66,67,68,69,70,71,72,73]);
    print(decode(readFile(path))); print("|");           // ABCDEFGHI
    print(decode(readFile(path, 3))); print("|");        // DEFGHI
    print(decode(readFile(path, 3, 2))); print("|");     // DE
    print(decode(readFile(path, null, 2))); print("|");  // AB
    print(decode(readFile(path, 100))); print("|");      // ofset taşması: boş
    print(readFile(path, 0, 0).length()); print("\n");
    removeFile(path);
    return 0;
}
