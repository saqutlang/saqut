import {writeFile, readFile, removeFile} from fs;
import {pid} from process;

void main() {
    byte[] data = [72, 73, 33];
    // PID son eki: ctest -j altında golden + differential eşzamanlı koşar.
    string path = "/tmp/saqut_fs_test_bytes_" + (pid() as string) + ".bin";
    writeFile(path, data);
    byte[] back = readFile(path);
    print(back.length());
    print(back[0]);
    print(back[1]);
    print(back[2]);
    byte[] invalid = [195, 40];
    print(invalid.toString());
    print("\n");
    removeFile(path);
}
