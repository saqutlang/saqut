import {writeFile, readFile, removeFile} from fs;
import {pid} from process;

void main() {
    // PID son eki: ctest -j altında golden + differential eşzamanlı koşar.
    string path = "/tmp/saqut_fs_test_write_read_" + (pid() as string) + ".txt";
    writeFile(path, "merhaba".toBuffer());
    print(readFile(path).toString());
    removeFile(path);
}
