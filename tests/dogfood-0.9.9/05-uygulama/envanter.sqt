// Adım 5: ilk gerçek uygulama — basit envanter/stok takibi.
//
// Buraya kadarki her şeyi bir arada kullanır: struct, enum, dizi, string,
// aritmetik, akış kontrolü, fonksiyonlar. Amacı "özellik denemek" değil,
// çalışan bir iş yapmak.

enum Kategori { Gida, Temizlik, Kirtasiye }

struct Urun {
    int    kod;
    string ad;
    Kategori kategori;
    int    adet;
    double birimFiyat;
}

struct Envanter {
    Urun[] urunler;
    string depoAdi;
}

void ekle(Envanter e, int kod, string ad, Kategori k, int adet, double fiyat) {
    Urun u;
    u.kod = kod; u.ad = ad; u.kategori = k; u.adet = adet; u.birimFiyat = fiyat;
    e.urunler.push(u);
}

int bul(Envanter e, int kod) {
    for (int i = 0; i < e.urunler.length(); i++) {
        if (e.urunler[i].kod == kod) { return i; }
    }
    return -1;
}

// Stok düşer. Yeterli değilse false döner, stoğa dokunmaz.
bool stokDus(Envanter e, int kod, int miktar) {
    int i = bul(e, kod);
    if (i < 0) { return false; }
    if (e.urunler[i].adet < miktar) { return false; }
    e.urunler[i].adet = e.urunler[i].adet - miktar;
    return true;
}

double toplamDeger(Envanter e) {
    double t = 0.0;
    for (int i = 0; i < e.urunler.length(); i++) {
        t = t + (e.urunler[i].adet as double) * e.urunler[i].birimFiyat;
    }
    return t;
}

string kategoriAdi(Kategori k) {
    if (k == Kategori.Gida)      { return "Gida"; }
    if (k == Kategori.Temizlik)  { return "Temizlik"; }
    return "Kirtasiye";
}

void rapor(Envanter e) {
    print("=== "); print(e.depoAdi); print(" ===\n");
    for (int i = 0; i < e.urunler.length(); i++) {
        Urun u = e.urunler[i];
        print(u.kod); print("  ");
        print(u.ad); print("  ");
        print(kategoriAdi(u.kategori)); print("  adet="); print(u.adet);
        print("  deger="); print((u.adet as double) * u.birimFiyat);
        print("\n");
    }
    print("TOPLAM: "); print(toplamDeger(e)); print("\n");
}

int main() {
    Envanter e;
    e.depoAdi = "Merkez Depo";
    e.urunler = [];

    ekle(e, 101, "Makarna",  Kategori.Gida,       50, 12.5);
    ekle(e, 102, "Deterjan", Kategori.Temizlik,   20, 45.0);
    ekle(e, 103, "Defter",   Kategori.Kirtasiye, 100,  8.75);

    rapor(e);

    print("\n-- 10 makarna satildi --\n");
    if (stokDus(e, 101, 10)) { print("ok\n"); } else { print("yetersiz\n"); }

    print("-- 999 deterjan isteniyor --\n");
    if (stokDus(e, 102, 999)) { print("ok\n"); } else { print("yetersiz stok\n"); }

    print("-- olmayan urun --\n");
    if (stokDus(e, 555, 1)) { print("ok\n"); } else { print("urun yok\n"); }

    print("\n");
    rapor(e);
    return 0;
}
