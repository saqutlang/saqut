// Adım 4c: struct ve enum.
enum Durum { Bekliyor, Calisiyor, Bitti }

struct Gorev {
    int id;
    string ad;
    Durum durum;
    bool acil;
}

struct Kutu { int[] sayilar; string etiket; }

void yazdir(Gorev g) {
    print(g.id); print(":"); print(g.ad); print(":"); print(g.durum); print("\n");
}

int main() {
    Gorev g;
    g.id = 1; g.ad = "ilk"; g.durum = Durum.Bekliyor; g.acil = false;
    yazdir(g);

    // enum degerleri
    print(Durum.Bekliyor); print(" ");
    print(Durum.Calisiyor); print(" ");
    print(Durum.Bitti); print("\n");        // 0 1 2

    // referans semantigi (ADR-020: struct referans)
    Gorev h = g;
    h.ad = "degisti";
    print(g.ad); print("\n");               // degisti (ayni nesne)

    // varsayilan degerler
    Gorev bos;
    print(bos.id); print("|");
    print(bos.ad); print("|");
    print(bos.acil); print("\n");           // 0||0

    // ic ice: struct icinde dizi
    Kutu k;
    k.etiket = "kutu";
    k.sayilar = [1,2,3];
    k.sayilar.push(4);
    print(k.sayilar.length()); print(" ");  // 4
    print(k.sayilar[3]); print("\n");       // 4

    // struct dizisi
    Gorev[] liste = [];
    for (int i = 0; i < 3; i++) {
        Gorev t; t.id = i; t.ad = "gorev" + (i as string);
        liste.push(t);
    }
    print(liste.length()); print(" ");      // 3
    print(liste[2].ad); print("\n");        // gorev2

    print(g.toJson()); print("\n");
    return 0;
}
