// Adım 4a: diziler — oluşturma, erişim, büyütme, metodlar.
int main() {
    int[] a = [3, 1, 4, 1, 5];
    print(a.length()); print(" ");       // 5
    print(a[0]); print(" ");             // 3
    print(a[4]); print("\n");            // 5

    a[0] = 99;
    print(a[0]); print("\n");            // 99

    // büyütme
    int[] b = [];
    for (int i = 1; i <= 5; i++) { b.push(i * i); }
    print(b.length()); print(" ");       // 5
    print(b[4]); print("\n");            // 25

    // toplam + max
    int toplam = 0; int enb = b[0];
    for (int i = 0; i < b.length(); i++) {
        toplam = toplam + b[i];
        if (b[i] > enb) { enb = b[i]; }
    }
    print(toplam); print(" ");           // 55
    print(enb); print("\n");             // 25

    // referans semantiği (ADR-020: dizi referans)
    int[] c = b;
    c[0] = -1;
    print(b[0]); print("\n");            // -1 (aynı nesne)

    // diğer tipler
    string[] s = ["bir", "iki"];
    print(s[1]); print(" ");
    double[] d = [1.5, 2.5];
    print(d[0] + d[1]); print(" ");      // 4
    byte[] by = [1, 2, 3];
    print(by.length()); print("\n");     // 3
    return 0;
}
