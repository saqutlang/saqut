// Adım 3b: fonksiyonlar, rekürsiyon, parametre geçişi.
int kare(int x) { return x * x; }
int topla(int a, int b) { return a + b; }
double ortalama(double a, double b) { return (a + b) / 2.0; }

int fib(int n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}

int faktoriyel(int n) {
    if (n <= 1) { return 1; }
    return n * faktoriyel(n - 1);
}

// değer semantiği: parametre kopyalanmalı, çağıran etkilenmemeli
void degistir(int x) { x = 999; }

void yanEtki() { print("yan "); }

int main() {
    print(kare(7)); print(" ");           // 49
    print(topla(3, 4)); print(" ");       // 7
    print(ortalama(3.0, 4.0)); print("\n"); // 3.5

    print(fib(10)); print(" ");           // 55
    print(fib(20)); print(" ");           // 6765
    print(faktoriyel(10)); print("\n");   // 3628800

    int d = 5;
    degistir(d);
    print(d); print("\n");                // 5 (değişmemeli)

    yanEtki();
    print(kare(kare(2))); print("\n");    // 16 (iç içe çağrı)
    return 0;
}
