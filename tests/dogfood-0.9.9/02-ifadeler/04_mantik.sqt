// Adım 2c: karşılaştırma, mantık, bitsel.
int main() {
    int a = 5; int b = 10;
    print(a < b); print(" ");   print(a > b); print(" ");
    print(a <= 5); print(" ");  print(a == b); print(" ");
    print(a != b); print("\n");

    // kısa devre: sağ taraf çalışmamalı
    int yan = 0;
    if (false && (yan = 1) == 1) { }
    print(yan); print(" ");          // 0
    if (true || (yan = 2) == 2) { }
    print(yan); print("\n");         // 0

    // bitsel
    int x = 12; int y = 10;          // 1100, 1010
    print(x & y); print(" ");        // 8
    print(x | y); print(" ");        // 14
    print(x ^ y); print(" ");        // 6
    print(~x); print(" ");           // -13
    print(x << 2); print(" ");       // 48
    print(x >> 2); print("\n");      // 3

    // ^ XOR mu üs mü (#230)
    print(2 ^ 3); print(" ");        // 1 (XOR)
    print(2 ** 3); print("\n");      // 8 (üs)
    return 0;
}
