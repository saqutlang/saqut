// Adım 2b: tip sınırları ve sarma davranışı (ADR-040: tanımlı wrap).
int main() {
    int max = 2147483647;
    print(max); print(" ");
    print(max + 1); print("\n");        // -2147483648 (sarar)

    int min = -2147483648;
    print(min); print(" ");
    print(min - 1); print("\n");        // 2147483647

    longint lmax = 9223372036854775807;
    print(lmax); print(" ");
    print(lmax + 1); print("\n");       // -9223372036854775808

    byte b = 255;
    int genis = b + 1;                  // byte+int → int (terfi eder)
    print(genis); print(" ");           // 256, sarma YOK
    byte c = 255; byte d = 1;
    print(c + d); print("\n");          // byte+byte → byte, sarar: 0
    return 0;
}
