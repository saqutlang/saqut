// Adım 2a: aritmetik. Elle hesaplanabilir değerler, her satır doğrulanabilir.
int main() {
    print(10 + 3);  print(" ");   // 13
    print(10 - 3);  print(" ");   // 7
    print(10 * 3);  print(" ");   // 30
    print(10 / 3);  print(" ");   // 3  (tamsayı bölme)
    print(10 % 3);  print(" ");   // 1
    print(2 ** 5);  print("\n");  // 32

    // öncelik
    print(2 + 3 * 4);      print(" ");   // 14
    print((2 + 3) * 4);    print(" ");   // 20
    print(-2 + 5);         print(" ");   // 3
    print(10 - 4 - 3);     print(" ");   // 3  (sol birleşim)
    print(2 ** 3 ** 2);    print("\n");  // 512 (sağ birleşim)

    // negatif sayılar
    print(-10 / 3);  print(" ");   // -3
    print(-10 % 3);  print(" ");   // -1
    print(7 / -2);   print("\n");  // -3
    return 0;
}
