// feature-sweep/c — stdin::readLine: 2 satir + EOF null
import {readLine} from stdin;

void main() {
    string? l1 = readLine();
    if (l1 == null) { print("L1=null\n"); } else { print("L1="); print(l1); print("\n"); }
    string? l2 = readLine();
    if (l2 == null) { print("L2=null\n"); } else { print("L2="); print(l2); print("\n"); }
    string? l3 = readLine();
    if (l3 == null) { print("L3=null\n"); } else { print("L3="); print(l3); print("\n"); }
}
