    print(42); print(" | "); print("str"); print(" | ");
    print(true); print(" | "); print(false); print(" | ");
    print(3.5); print(" | "); print(2.25); print(" | ");
    decimal d = 1.5; print(d); print(" | ");
    print(E.B); print(" | ");
